# Robinhood Chain
NEXT_PUBLIC_CHAIN_ID=4663
NEXT_PUBLIC_RPC_URL=https://rpc.mainnet.chain.robinhood.com
NEXT_PUBLIC_EXPLORER_URL=https://robinhoodchain.blockscout.com

# Contracts (leave empty until deployed)
NEXT_PUBLIC_NFT_ADDRESS=
NEXT_PUBLIC_MILK_ADDRESS=
NEXT_PUBLIC_CLOCK_ADDRESS=

# Mint feature flag: unix seconds. Empty or 0 = closed.
NEXT_PUBLIC_MINT_OPENS_AT=

# Optional fallback if the NFT contract has no mintPrice()
NEXT_PUBLIC_MINT_PRICE_MILK=

# Optional WalletConnect Cloud id
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
